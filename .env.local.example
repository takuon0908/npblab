# microCMS
MICROCMS_SERVICE_DOMAIN=
MICROCMS_API_KEY=

# DB (Supabase等のPostgres接続文字列)
DATABASE_URL="postgresql://user:password@host:5432/postgres"

# 本番サイトURL（デプロイ後に設定）
NEXT_PUBLIC_SITE_URL="https://example.com"

# Google Analytics (GA4) 測定ID
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# 楽天市場商品検索API(商品の自動検索・アフィリエイトリンク生成用)
RAKUTEN_APPLICATION_ID=
RAKUTEN_ACCESS_KEY=
RAKUTEN_AFFILIATE_ID=

# GA4 Data API(実績データ取得用。キーファイルはcredentials/に置きgit管理外にする)
GA4_SERVICE_ACCOUNT_KEY_PATH=./credentials/ga4-service-account.json
GA4_PROPERTY_ID=
